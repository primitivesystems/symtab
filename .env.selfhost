# ────────────────────────────────────────────────────────────
#  Flux — Self-Hosting Configuration Template
# ────────────────────────────────────────────────────────────
#
# Copy this file to .env and edit the values for your setup:
#
#   cp .env.selfhost .env
#
# Then start Flux with:
#
#   docker compose -f docker-compose.selfhost.yml up -d
#

# ── Access ────────────────────────────────────────────────────────────────────

# The public URL that users will open in their browser.
# Used for CORS and link generation.
# Examples:
#   http://localhost:3000          (local machine)
#   https://flux.yourdomain.com    (reverse-proxied with TLS)
# Use the exact origin, without a trailing slash. Remote access requires HTTPS.
PUBLIC_URL=http://localhost:3000

# Host-loopback port (maps to container port 80). Never publish directly to the internet.
# Change this if 3000 is already in use.
WEB_PORT=3000

# Required only until the owner account exists. Generate with: openssl rand -hex 32
# Keep secret. Enter this key on the initial setup page, then remove it here.
FLUX_SETUP_KEY=

# ── Plugin Marketplace (optional) ─────────────────────────────────────────────

# Leave all three blank to disable the plugin marketplace.
# FLUX_PLUGIN_REGISTRY_URL=
# FLUX_PLUGIN_REGISTRY_SIGNATURE_URL=
# FLUX_PLUGIN_REGISTRY_PUBLIC_KEY=

# ── Advanced ──────────────────────────────────────────────────────────────────

# Override the internal vault storage path inside the container.
# Only set this if you're mounting an external volume at a custom path.
# Default: /data/vaults  (managed Docker volume)
# FLUX_VAULT_ROOT=/data/vaults

# Override where Flux stores its app database and plugin state.
# Default: /data/appdata  (managed Docker volume)
# FLUX_APP_DATA_DIR=/data/appdata
