{
  "name": "@symtab/desktop",
  "version": "0.0.2",
  "description": "Symtab personal knowledge management desktop application",
  "author": "Symtab Contributors",
  "private": true,
  "type": "module",
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "vite",
    "build": "bun run clean:build && bun run build:server && tsc --noEmit && vite build && electron-builder",
    "release": "bun run build:server && tsc --noEmit && vite build && electron-builder --mac dmg --publish never",
    "build:server": "mkdir -p resources && ${GO_BIN:-/usr/local/go/bin/go} -C ../../server build -tags sqlite_fts5 -o ../apps/desktop/resources/symtab-server .",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "clean:build": "rm -rf dist dist-electron release resources/symtab-server",
    "clean": "bun run clean:build"
  },
  "dependencies": {
    "@symtab/app-core": "workspace:*",
    "@symtab/client-desktop": "workspace:*",
    "@symtab/shared-ui": "workspace:*",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "43.1.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vite-plugin-electron": "^1.1.0"
  },
  "build": {
    "appId": "com.symtab.desktop",
    "productName": "Symtab",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!node_modules/@symtab/**/*",
      "!node_modules/**/.turbo{,/**/*}",
      "!node_modules/**/.cache{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "resources/symtab-server",
        "to": "symtab-server"
      },
      {
        "from": "assets/icon.png",
        "to": "symtab.png"
      },
      {
        "from": "assets/dock-icon-dark.png",
        "to": "dock-icon-dark.png"
      },
      {
        "from": "assets/dock-icon-light.png",
        "to": "dock-icon-light.png"
      },
      {
        "from": "assets/menubarTemplate.png",
        "to": "menubarTemplate.png"
      },
      {
        "from": "assets/menubarTemplate@2x.png",
        "to": "menubarTemplate@2x.png"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "primitivesystems",
      "repo": "symtab",
      "releaseType": "release"
    },
    "mac": {
      "icon": "public/logo.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
