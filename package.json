{
  "name": "flux",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.18",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@flux/desktop",
    "dev:all": "turbo run dev",
    "dev:desktop": "turbo run dev --filter=@flux/desktop",
    "dev:web": "turbo run dev --filter=@flux/web",
    "dev:server": "${GO_BIN:-/usr/local/go/bin/go} -C server run -tags sqlite_fts5 .",
    "test:server": "${GO_BIN:-/usr/local/go/bin/go} -C server test -tags sqlite_fts5 ./...",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "bun run typecheck && bun --cwd packages/client-web test && bun run test:server",
    "test:v1": "bun run typecheck && bun test apps/desktop/test && bun --cwd packages/client-web test && ${GO_BIN:-/usr/local/go/bin/go} -C server test -tags sqlite_fts5 ./internal/app ./internal/files ./internal/index ./internal/vault",
    "clean": "turbo run clean && bun run clean:cache",
    "clean:cache": "rm -rf .cache .turbo apps/*/.turbo packages/*/.turbo",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prettier": "^3.2.5",
    "shadcn": "^4.14.0",
    "turbo": "^2.0.0",
    "typescript-eslint": "^8.56.1"
  },
  "resolutions": {
    "pdfjs-dist": "^6.2.108",
    "browserslist": "^4.28.7",
    "postcss": "^8.5.23",
    "qs": "^6.16.0",
    "nanoid": "^3.3.18",
    "js-yaml": "^4.3.1",
    "tar": "^7.5.21",
    "undici": "^7.29.0",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.6",
    "ip-address": "^10.3.1"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  }
}
